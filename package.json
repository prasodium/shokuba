{
  "name": "shokuba",
  "productName": "Shokuba",
  "version": "0.0.1",
  "description": "職場 (Shokuba) — A Multi-Agent Harness. Watch, control, and verify a living team of AI software engineers.",
  "keywords": [
    "ai-agents",
    "multi-agent",
    "orchestration",
    "electron",
    "claude-code",
    "codex",
    "gemini-cli",
    "voxel",
    "isometric",
    "pixijs",
    "developer-tools"
  ],
  "license": "MIT",
  "author": "prasodium",
  "homepage": "https://github.com/prasodium/shokuba",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prasodium/shokuba.git"
  },
  "bugs": {
    "url": "https://github.com/prasodium/shokuba/issues"
  },
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "node scripts/postinstall.mjs",
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "typecheck:node": "tsc --noEmit --composite false -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit --composite false -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "electron-vite build && node scripts/smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "node-pty": "^1.1.0",
    "pixi.js": "^8.21.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "prettier": "^3.9.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.1",
    "zustand": "^5.0.15"
  }
}
